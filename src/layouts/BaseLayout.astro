---
import BaseHead from "../components/BaseHead.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  frontmatter?: { title?: string; description?: string };
}

const {
  frontmatter,
  title: titleProp,
  description: descProp,
  image,
} = Astro.props;
const title = frontmatter?.title ?? titleProp;
const description = frontmatter?.description ?? descProp;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} />
    <slot name="head" />
  </head>
  <body>
    <header>
      <nav>
        <a href="/">home</a>
        <a href="/about">about</a>
        <a href="/projects">projects</a>
        <a href="/contact">contact</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <nav>
        <a href="/rss.xml">RSS</a>
        <a href="https://github.com/sjcobb2022/blog">impl Blog</a>
      </nav>
    </footer>
  </body>
</html>
