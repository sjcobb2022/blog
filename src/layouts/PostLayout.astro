---
import "katex/dist/katex.min.css";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  categories?: string[];
}

const { title, categories = [] } = Astro.props;
---

<BaseLayout title={title}>
  <article>
    <slot />
    {
      categories.length > 0 && (
        <section>
          <p>
            {categories.map((cat, i) => (
              <>
                <a href={`/blog/category/${cat}`}>#{cat}</a>
                {i < categories.length - 1 ? " " : ""}
              </>
            ))}
          </p>
        </section>
      )
    }
  </article>
</BaseLayout>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  /* clickable headers */
  article :is(h1, h2, h3, h4, h5, h6) {
    position: relative;
    width: fit-content;
  }
  article :is(h1, h2, h3, h4, h5, h6) a[aria-hidden] {
    position: absolute;
    inset: 0;
    cursor: text;
  }

  /* reset counter for sidenotes */
  article {
    counter-reset: sidenote-counter;
  }

  /* remove background */
  .astro-code,
  .astro-code span {
    background: none !important;
  }

  @media (prefers-color-scheme: dark) {
    .astro-code,
    .astro-code span {
      background: none !important;
      color: var(--shiki-dark) !important;
    }
  }
</style>
